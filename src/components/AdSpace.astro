---
// Vertical ad slot, pinned to the left side of the page.
// Fixed portrait size: width x height (default 500 x 1200).
// Shown from xl breakpoint (1280px) up — below that there isn't enough
// room in the left margin next to the centered content column for a
// 500px-wide box, so it's hidden rather than overlapping.
//
// TO ADD YOUR OWN AD IMAGE OR VIDEO:
// 1. Drop the file into your project's `public/` folder, e.g.
//      public/ads/my-ad.jpg
//      public/ads/my-ad.mp4
// 2. Set mediaSrc below to that path, starting with a slash: "/ads/my-ad.jpg"
// 3. Set mediaType to "image" or "video" to match.
// 4. Optionally set link to a URL — the whole box becomes clickable.

interface Props {
  width?: number;
  height?: number;
}

const { width = 500, height = 1200 } = Astro.props;

const mediaType: "image" | "video" | "none" = "none"; // "image" | "video" | "none"
const mediaSrc = ""; // e.g. "/ads/my-ad.jpg"
const link = ""; // optional — leave empty for no click-through
---

<aside
  class="ad-rail hidden xl:flex fixed left-8 top-28 flex-col z-20 overflow-hidden border-2 border-dashed border-ink/25 rounded-sm bg-ink/[0.08]"
  style={`--ad-w:${width}px; --ad-h:${height}px;`}
  aria-label="Advertisement"
>
  {mediaType !== "none" && mediaSrc ? (
    link ? (
      <a href={link} target="_blank" rel="noopener" class="block w-full h-full">
        {mediaType === "video" ? (
          <video src={mediaSrc} autoplay muted loop playsinline class="w-full h-full object-cover" />
        ) : (
          <img src={mediaSrc} alt="Advertisement" class="w-full h-full object-cover" />
        )}
      </a>
    ) : mediaType === "video" ? (
      <video src={mediaSrc} autoplay muted loop playsinline class="w-full h-full object-cover" />
    ) : (
      <img src={mediaSrc} alt="Advertisement" class="w-full h-full object-cover" />
    )
  ) : (
    <div class="flex flex-col items-center justify-center gap-3 w-full h-full">
      <p class="font-mono text-xs tracking-[0.25em] text-ink/50 uppercase">Advertisement</p>
      <p class="font-mono text-[13px] text-ink/35">{width} &times; {height}</p>
    </div>
  )}
</aside>

<style>
  .ad-rail {
    width: var(--ad-w, 500px);
    /* fixed height, but capped so it never overflows a shorter viewport */
    height: min(var(--ad-h, 1200px), calc(100vh - 8rem));
  }
</style>