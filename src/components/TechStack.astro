---
const stack = [
  { name: "Python", icon: "devicon-python-plain" },
  { name: "Django", icon: "devicon-django-plain" },
  { name: "PostgreSQL", icon: "devicon-postgresql-plain" },
  { name: "JavaScript", icon: "devicon-javascript-plain" },
  { name: "React", icon: "devicon-react-original" },
  { name: "Next.js", icon: "devicon-nextjs-original" },
  { name: "Tailwind CSS", icon: "devicon-tailwindcss-plain" },
  { name: "Git", icon: "devicon-git-plain" },
];

// duplicated once so the marquee can loop seamlessly at -50%
const loopedStack = [...stack, ...stack];
---
<section id="stack" class="reveal max-w-4xl mx-auto py-16">
  <h2 class="font-display italic text-2xl text-amber/90 mb-6 px-6">Stack</h2>
  <div class="marquee-wrapper">
    <div class="marquee-track">
      {loopedStack.map((t) => (
        <div class="stack-chip flex flex-col items-center gap-2 shrink-0 w-24 group">
          <i class={`${t.icon} tech-icon text-4xl`}></i>
          <span class="font-body text-xs text-ink/50 group-hover:text-amber transition-colors text-center">{t.name}</span>
        </div>
      ))}
    </div>
  </div>
  <p class="font-body text-sm text-ink/40 mt-6 px-6">+ Django REST Framework and REST APIs</p>
</section>