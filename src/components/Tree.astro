---
// Small ambient tree, tucked in the bottom-left corner, swaying gently.
// Two independent CSS animations (trunk+canopy together, canopy alone)
// running at different speeds so it reads as an uneven breeze rather
// than a single mechanical loop. Hidden below 900px so it never
// competes with content on smaller screens. Pure CSS/SVG — no library.
---
<div class="cozy-tree" aria-hidden="true">
  <svg viewBox="0 0 160 200" width="140" height="175" xmlns="http://www.w3.org/2000/svg">
    <g class="tree-sway">
      <rect x="70" y="118" width="18" height="72" rx="6" fill="#4A3324" />
      <g class="tree-canopy">
        <ellipse cx="80" cy="72" rx="54" ry="48" fill="#7C9C7A" />
        <ellipse cx="54" cy="92" rx="36" ry="32" fill="#9CB89A" />
        <ellipse cx="107" cy="96" rx="38" ry="34" fill="#88AC86" />
        <ellipse cx="80" cy="56" rx="40" ry="36" fill="#A8C2A5" opacity="0.9" />
      </g>
    </g>
  </svg>
</div>