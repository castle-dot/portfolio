---
import '../styles/global.css';
export interface Props { title?: string }
const { title = "Kaleb Getnet — Engineering & Architecture" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Kaleb Getnet — full-stack software developer and backend architecture." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
</head>
<body class="relative min-h-screen bg-[var(--color-base)] text-[var(--color-text-main)] overflow-x-hidden">
  <!-- Background: a still lattice, a soft vignette, and a few slow-drifting nodes -->
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="vignette-overlay" aria-hidden="true"></div>
  
  <slot />

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger);

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // A sparse handful of nodes drifting up through the page — mostly muted,
    // with the odd cyan or orange one, standing in for records moving
    // through a pipeline rather than decorative fireflies.
    if (!reduceMotion) {
      const nodeCount = window.innerWidth < 640 ? 7 : 12;
      const glowColors = [
        'rgba(148, 163, 184, 0.9)',
        'rgba(148, 163, 184, 0.9)',
        'rgba(148, 163, 184, 0.9)',
        'var(--color-cyan)',
        'var(--color-orange)',
      ];
      for (let i = 0; i < nodeCount; i++) {
        const node = document.createElement('span');
        node.className = 'data-node';
        const duration = 24 + Math.random() * 18; // 24s–42s, unhurried
        node.style.left = `${Math.random() * 100}vw`;
        node.style.setProperty('--glow', glowColors[Math.floor(Math.random() * glowColors.length)]);
        node.style.animationDuration = `${duration}s`;
        node.style.animationDelay = `-${Math.random() * duration}s`; // stagger so they don't all launch together
        document.body.appendChild(node);
      }
    }

    if (!reduceMotion) {
      const lenis = new Lenis({ 
        duration: 1.2, 
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true 
      });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
    }

    // Modern 3D reveal animation
    document.querySelectorAll('.reveal').forEach((el) => {
      if (reduceMotion) {
        el.classList.add('in-view');
        return;
      }
      gsap.fromTo(
        el,
        { autoAlpha: 0, y: 40, scale: 0.95, rotateX: -5 },
        {
          autoAlpha: 1,
          y: 0,
          scale: 1,
          rotateX: 0,
          duration: 1.2,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%' },
        }
      );
    });
  </script>
</body>
</html>